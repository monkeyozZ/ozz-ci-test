{
	admin off
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	skip_install_trust
	email "{$ACME_EMAIL:}"
}

https://{$CONSOLE_HOST}:8443 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

http://{$CONSOLE_HOST}:8080 {
	redir {$APP_ORIGIN}{uri} 308
}

http://:8081 {
	respond /health/live "ok" 200
}
