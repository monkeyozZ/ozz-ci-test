# Copy to .env with your own values, or run pnpm dev:setup for random local secrets.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=3000
WORKER_HEALTH_PORT=3001
POSTGRES_USER=ozz
POSTGRES_DB=ozz
POSTGRES_PASSWORD=replace-with-a-random-value
REDIS_PASSWORD=replace-with-a-different-random-value
DATABASE_URL=postgresql://ozz:replace-with-a-random-value@127.0.0.1:54320/ozz?schema=public&connection_limit=5&pool_timeout=5&connect_timeout=5
REDIS_URL=redis://:replace-with-a-different-random-value@127.0.0.1:56379/0
# Versioned JSON keyring: generated only by explicit local setup, never on application startup.
MASTER_KEY_FILE=/absolute/path/to/ozz/.secrets/master-key.json
RESTORE_MODE=false
LOG_LEVEL=info
SESSION_TTL_SECONDS=28800
# Empty means forwarded headers are untrusted. Configure only the Caddy peer/network in production.
TRUSTED_PROXY_CIDRS=
TASK_LOG_RETENTION_DAYS=7
TASK_LOG_MAX_BYTES=16384
# Optional per-process resolvers (literal IPs with optional ports); empty uses system DNS.
NETWORK_DNS_SERVERS=
# Explicit local ACME test configuration; rejected in production and never changes system trust.
NETWORK_LOCAL_ACME_CONFIG_FILE=
# Optional explicit outbound proxy for registry verification. Leave empty on servers with working public DNS.
REGISTRY_HTTP_PROXY=
# Exact HTTPS origins for registry blob redirects resolved by the proxy, comma-separated.
REGISTRY_PROXY_BLOB_ORIGINS=
